# Generic systemd unit. Assumes the binary and data live in /opt/woogles-tv and run as user "woogles":
#   sudo useradd --system --home /opt/woogles-tv --shell /usr/sbin/nologin woogles
#   sudo install -d -o woogles -g woogles /opt/woogles-tv /opt/woogles-tv/data
#   sudo cp woogles-tv /opt/woogles-tv/ && sudo cp -r data/letterdistributions data/strategy /opt/woogles-tv/data/
#   sudo chown -R woogles:woogles /opt/woogles-tv/data
#   sudo cp deploy/woogles-tv.service /etc/systemd/system/ && sudo systemctl enable --now woogles-tv
#   sudo install -m 600 deploy/woogles-tv.env.example /opt/woogles-tv/woogles-tv.env   # optional settings
# Adjust paths and the port to taste. See docs/DEPLOY.md.
[Unit]
Description=Woogles-TV living-room crossword game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=woogles
Group=woogles
WorkingDirectory=/opt/woogles-tv
ExecStart=/opt/woogles-tv/woogles-tv -addr :8420 -data /opt/woogles-tv/data
# Optional settings (PUBLIC_URL, definitions, Cast, the announcer's server voice) go in this file; every one is listed
# with a short explanation in deploy/woogles-tv.env.example:
#   sudo install -m 600 deploy/woogles-tv.env.example /opt/woogles-tv/woogles-tv.env
# The leading "-" means the file may be missing.
EnvironmentFile=-/opt/woogles-tv/woogles-tv.env
Restart=always
RestartSec=2

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/woogles-tv/data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=1500M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
