# Optional settings for the Woogles-TV server. Everything here can stay commented out: the defaults work.
#
# With systemd (deploy/woogles-tv.service):
#   sudo install -m 600 deploy/woogles-tv.env.example /opt/woogles-tv/woogles-tv.env
#   sudo nano /opt/woogles-tv/woogles-tv.env     # uncomment what you need
#   sudo systemctl restart woogles-tv
# Also works with `docker run --env-file`. Format: NAME=value, no quotes or spaces around "=".
# Full list: docs/DEPLOY.md (Configuration).

# The URL phones use to reach the server; it goes into the TV's QR code and invite links. If unset, it's derived
# from each request, which works behind most proxies. Set it if the QR code shows the wrong address.
#PUBLIC_URL=https://woogles-tv.example.com

# Word definitions (double-tap a word in the scorecard, or the TV's definition card). On by default; looks up only
# words already played, from Woogles.io's word service (fallback: dictionaryapi.dev).
#WT_DEFINITIONS=off
# Another endpoint that speaks the same DefineWords JSON API.
#WT_DEFINE_URL=https://example.com/word_service.WordService/DefineWords

# Google Cast receiver app ID; turns on the Cast buttons. See docs/CAST.md.
#CAST_APP_ID=ABCD1234

# Server voice for the announcer (audio.cpp + Pocket TTS in Docker; see docs/TTS.md). Empty = off, and TVs and
# phones use their own built-in speech.
#WT_TTS_URL=http://127.0.0.1:8431
# Voices offered, in menu order; the first is the default. Names are files in
# tts/models/PocketTTS-GGUF/english/embeddings/.
#WT_TTS_VOICES=cosette,caro_davy,anna,azelma,charles,eve,fantine,jane,marius,mary,michael,paul,peter_yearsley,stuart_bell,vera
# Model id in tts/server.json (only change it if you edited that file).
#WT_TTS_MODEL=pocket

# Stats (rooms, games, connections, lifetime counters; counts only). See docs/DEPLOY.md (Stats).
# A separate local-only listener with GET /stats. Keep it on 127.0.0.1.
#WT_ADMIN_ADDR=127.0.0.1:8421
# Or/also GET /api/stats on the public site, with "Authorization: Bearer <token>". 24+ characters, e.g. the output
# of: openssl rand -hex 24
#WT_STATS_TOKEN=
